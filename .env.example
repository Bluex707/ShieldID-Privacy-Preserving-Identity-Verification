# Copy of the variables ShieldID understands. You normally do NOT write .env by
# hand: `python setup_dev.py` generates random secrets, and
# `python deploy_contract.py` appends ISSUER_REGISTRY_ADDRESS.
# Real environment variables take precedence over this file.

# --- generated by setup_dev.py (>= 32 chars, random) ---
WALLET_CLIENT_SECRET=
ISSUER_SERVICE_CLIENT_SECRET=
WALLET_SERVICE_CLIENT_SECRET=
DEMO_STUDENT_PASSWORD=

# --- written by deploy_contract.py ---
ISSUER_REGISTRY_ADDRESS=

# --- optional overrides (defaults shown) ---
# ETH_RPC_URL=http://127.0.0.1:8545
# ISSUER_ID=University_of_Jordan.edu.jo
# TRUSTED_ISSUER_IDS=University_of_Jordan.edu.jo
# BIND_HOST=127.0.0.1
# DEMO_STUDENT_USERNAME=sara222
# FLASK_SECRET_KEY=            # set only if sessions must survive restarts
# ALLOWED_VERIFIER_CALLBACKS=https://localhost:5001/api/verify
# VERIFIER_PUBLIC_CALLBACK_URL=https://localhost:5001/api/verify
# SECURITY_LOG_PATH=logs/security.log
# STATUS_CACHE_DIR=data/status_cache
